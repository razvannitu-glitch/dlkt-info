{
  "functions": {
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/demo.ts": {
      "maxDuration": 10
    },
    "api/companion.ts": {
      "maxDuration": 10
    },
    "api/persistence.ts": {
      "maxDuration": 10
    },
    "api/persistence-health.ts": {
      "maxDuration": 10
    },
    "api/auth.ts": {
      "maxDuration": 10
    },
    "api/eu-official-health.ts": {
      "maxDuration": 10
    },
    "api/eu-official-acquire.ts": {
      "maxDuration": 30
    },
    "api/internal-delta-trial.ts": {
      "maxDuration": 30
    },
    "api/internal-delta-review.ts": {
      "maxDuration": 10
    },
    "api/internal-delta-health.ts": {
      "maxDuration": 10
    },
    "api/provisioning-health.ts": {
      "maxDuration": 10
    },
    "api/eu-official-live.ts": {
      "maxDuration": 15
    },
    "api/eu-official-delta.ts": {
      "maxDuration": 15
    },
    "api/operational-delta-collect.ts": {
      "maxDuration": 30
    },
    "api/operational-delta.ts": {
      "maxDuration": 15
    },
    "api/operational-delta-health.ts": {
      "maxDuration": 10
    },
    "api/connections.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/briefing",
      "destination": "/index.html"
    },
    {
      "source": "/start",
      "destination": "/start.html"
    },
    {
      "source": "/companion",
      "destination": "/companion.html"
    },
    {
      "source": "/companion-preview",
      "destination": "/companion-preview.html"
    },
    {
      "source": "/live",
      "destination": "/live.html"
    },
    {
      "source": "/delta",
      "destination": "/delta.html"
    },
    {
      "source": "/review",
      "destination": "/review.html"
    },
    {
      "source": "/today",
      "destination": "/today.html"
    },
    {
      "source": "/history",
      "destination": "/history.html"
    },
    {
      "source": "/memory",
      "destination": "/memory.html"
    },
    {
      "source": "/trust",
      "destination": "/trust.html"
    },
    {
      "source": "/actions",
      "destination": "/actions.html"
    },
    {
      "source": "/inbox",
      "destination": "/inbox.html"
    },
    {
      "source": "/delivery",
      "destination": "/delivery.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/api/demo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/companion",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/persistence",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/persistence-health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/auth",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/eu-official-health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/eu-official-acquire",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/internal-delta-trial",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/internal-delta-review",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/internal-delta-health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/provisioning-health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/operational-delta-collect",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/operational-delta",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/api/operational-delta-health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "schedules": {
    "eu-official-acquisition": {
      "schedule": "17 * * * *",
      "path": "/api/eu-official-acquire",
      "requestMethod": "GET"
    },
    "internal-delta-trial": {
      "schedule": "47 * * * *",
      "path": "/api/internal-delta-trial",
      "requestMethod": "GET"
    },
    "operational-delta-ledger": {
      "schedule": "27 * * * *",
      "path": "/api/operational-delta-collect",
      "requestMethod": "GET"
    }
  }
}
